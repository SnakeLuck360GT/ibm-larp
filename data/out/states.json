  "assumptions": [
    {
      "name": "Dataset: population_state",
      "value": "Population by state, sex, age group and ethnicity (thousands) (years 1970-2026)",
      "unit": "",
      "source": "DOSM / data.gov.my (OpenDOSM), CC BY 4.0; https://storage.dosm.gov.my/population/population_state.parquet"
    },
    {
      "name": "Dataset: hies_state",
      "value": "HIES headline stats by state: mean/median income, gini, poverty (years 2022-2024)",
      "unit": "",
      "source": "DOSM / data.gov.my (OpenDOSM), CC BY 4.0; https://storage.dosm.gov.my/hies/hies_state.parquet"
    },
    {
      "name": "Dataset: hh_income_state",
      "value": "Mean and median household income by state, all HIES years (years 1970-2024)",
      "unit": "",
      "source": "DOSM / data.gov.my (OpenDOSM), CC BY 4.0; https://storage.dosm.gov.my/hies/hh_income_state.parquet"
    },
    {
      "name": "Dataset: hh_poverty_state",
      "value": "Absolute, hardcore and relative poverty rate by state, all HIES years (years 1970-2024)",
      "unit": "",
      "source": "DOSM / data.gov.my (OpenDOSM), CC BY 4.0; https://storage.dosm.gov.my/hies/hh_poverty_state.parquet"
    },
    {
      "name": "Dataset: hospital_beds",
      "value": "Hospital beds by state, district and facility type (years 2015-2024)",
      "unit": "",
      "source": "DOSM / data.gov.my (OpenDOSM), CC BY 4.0; https://storage.data.gov.my/healthcare/hospital_beds.parquet"
    },
    {
      "name": "Dataset: hh_income_state",
      "value": "state, year, income_median, income_mean (RM/month); rows missing either value dropped (years 1974-2024)",
      "unit": "",
      "source": "DOSM / data.gov.my (OpenDOSM), CC BY 4.0; https://storage.dosm.gov.my/hies/hh_income_state.parquet"
    },
    {
      "name": "Dataset: open-meteo air-quality (CAMS global)",
      "value": "Daily mean PM2.5 (ug/m3) at each state capital (state_ref.csv), from hourly CAMS global model output; history only exists from Aug 2022 (years 2022-2026)",
      "unit": "",
      "source": "Open-Meteo Air Quality API / Copernicus CAMS, CC BY 4.0; https://air-quality-api.open-meteo.com/v1/air-quality"
    },
    {
      "name": "Reference year",
      "value": "2024",
      "unit": "year",
      "source": "Latest year present in population, income, poverty and beds tables"
    },
    {
      "name": "PM2.5 exposure (ranking)",
      "value": "Mean daily PM2.5 at state capital, Aug 2022 - Sep 2026, same value for every year; Selangor and KL share one CAMS grid cell",
      "unit": "ug/m3",
      "source": "Open-Meteo Air Quality API / Copernicus CAMS, CC BY 4.0"
    },
    {
      "name": "Unhealthy-air day",
      "value": "35",
      "unit": "ug/m3 (24 h mean PM2.5)",
      "source": "Malaysia Ambient Air Quality Standard 2020"
    },
    {
      "name": "PM2.5 by horizon (24/48/72 h)",
      "value": "CAMS forecast at state capital, mean of each 24 h window ahead, issued 2026-10-17T19:00:00 (fetched); stand-in until forecast.json from the physical model lands",
      "unit": "ug/m3",
      "source": "Open-Meteo Air Quality API / Copernicus CAMS, CC BY 4.0"
    },
    {
      "name": "Priority label (PROXY)",
      "value": "PROXY, not ground truth. harm = exposure x vulnerable people, graded 0-3 by within-year quartile (3 = most harm). Exposure = pm25_mean. Mean daily PM2.5 rather than unhealthy-day count: CAMS reads ~40 ug/m3 over the Klang Valley, just above the 35 ug/m3 threshold, so day counts there are inflated ~10-300x vs other states.",
      "unit": "grade 0-3",
      "source": "Team assumption: no official haze-priority list exists; poor households weighted 2x because exposure correlates with income (rho ~0.7)"
    },
    {
      "name": "Vulnerable people weights",
      "value": "{\"pct_65plus\": 1, \"pct_under5\": 1, \"poverty_rate\": 2}",
      "unit": "multiplier on % of population",
      "source": "Team assumption: no official haze-priority list exists; poor households weighted 2x because exposure correlates with income (rho ~0.7)"
    },
    {
      "name": "Baseline weights",
      "value": "{\"income_median\": -0.4, \"pct_65plus\": 0.2, \"pct_under5\": 0.2, \"beds_per_1000\": -0.2}",
      "unit": "weight on within-year z-score",
      "source": "HazeGuard-MY brief: weighted index (low median income 0.4, 65+ 0.2, under-5 0.2, low beds 0.2) on within-year z-scores"
    },
    {
      "name": "Ranker",
      "value": "XGBRanker (objective=rank:pairwise, max_depth=2, n_estimators=100, learning_rate=0.1, random_state=42); leave-one-year-out; gain = proxy grade (0-3), sklearn ndcg_score; NDCG@5 0.9832 vs baseline 0.6079",
      "unit": "",
      "source": "This pipeline (pipeline/03_equity.py)"
    },
    {
      "name": "Mobile clinic stock",
      "value": "6",
      "unit": "clinics",
      "source": "HazeGuard-MY brief default; placeholder, not real MOH stock"
    },
    {
      "name": "N95 stock",
      "value": "300000",
      "unit": "masks",
      "source": "HazeGuard-MY brief default; placeholder, not real MOH stock"
    },
    {
      "name": "Clinic rule",
      "value": "one mobile clinic per state in priority order until clinics run out",
      "unit": "",
      "source": "HazeGuard-MY brief (team decision)"
    },
    {
      "name": "N95 rule",
      "value": "states with priority <= 10 share the N95 stock in proportion to vulnerable people (label.vulnerable_weights), capped at 1 each; rounding leftovers go to the most urgent state first",
      "unit": "",
      "source": "HazeGuard-MY brief (team decision)"
    },
    {
      "name": "Actions",
      "value": "priority <= 5: Deploy mobile clinic + distribute N95s; priority <= 10: Pre-position N95s, issue advisory; priority <= 16: Monitor",
      "unit": "",
      "source": "HazeGuard-MY brief (team decision)"
    },
    {
      "name": "Poverty line",
      "value": "DOSM revised the poverty line in 2019, so 2016 rates use the old, lower line; features are z-scored within year so only the ordering of states is compared",
      "unit": "% of households",
      "source": "DOSM / data.gov.my (OpenDOSM), CC BY 4.0"
    },
    {
      "name": "State capital coordinates and area",
      "value": "Hard-coded in data/resource_allocation/state_ref.csv",
      "unit": "deg, km2",
      "source": "Team reference table"
    }
  ]
}
